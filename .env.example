# Aruta SSO Client Configuration (Bahasa Aruta)
# ----------------------------------------------------
# Client ID terdaftar di Aruta SSO (https://accounts.aruta.id)
ARUTA_CLIENT_ID=aruta_app_ue8mu3

# Client Secret (WAJIB RAHASIA! HANYA DI SERVER, JANGAN PERNAH EXPOSE KE BROWSER)
ARUTA_CLIENT_SECRET=ARUTA_CLIENT_SECRET_PLACEHOLDER

# Base URL Aruta SSO Identity Provider
ARUTA_SSO_BASE_URL=https://accounts.aruta.id

# Client-Side Public Variables (Aman untuk Browser)
NEXT_PUBLIC_ARUTA_CLIENT_ID=aruta_app_ue8mu3
NEXT_PUBLIC_ARUTA_SSO_BASE_URL=https://accounts.aruta.id

# Base URL Aplikasi Klien Ini (Ganti saat deployment produksi ke https://bahasa.aruta.id)
NEXT_PUBLIC_APP_URL=http://localhost:3040

# Secret Key untuk Menandatangani HttpOnly Session Cookie (Minimal 32 karakter)
SESSION_SECRET=aruta_basa_session_secret_change_me_in_production_key_32bytes
